@model IEnumerable<WEB_TinhNguyen.Areas.CuaHang.Models.SanPhamGayQuy>
@{
    ViewData["Title"] = "Cửa Hàng Gây Quỹ - Trăng Sáng Langbiang 2026";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCat = ViewBag.CurrentCategory as string ?? "Tất cả";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentSort = ViewBag.CurrentSort as string ?? "";
    var totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : (Model?.Count() ?? 0);
    var productList = Model?.ToList() ?? new List<WEB_TinhNguyen.Areas.CuaHang.Models.SanPhamGayQuy>();
    var newestProducts = productList.OrderByDescending(x => x.IDSanPham).Take(3).ToList();
}

<div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-5">

    <!-- FLASH MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm">
            <div class="flex items-center gap-2.5 min-w-0">
                <i class="fas fa-check-circle text-emerald-600 text-lg shrink-0"></i>
                <span class="text-xs sm:text-sm font-semibold truncate">@TempData["SuccessMessage"]</span>
            </div>
            <a asp-area="CuaHang" asp-controller="GioHang" asp-action="Index" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white transition shrink-0 ml-2">
                Xem giỏ hàng
            </a>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center gap-2.5 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold shadow-sm">
            <i class="fas fa-exclamation-circle text-rose-600 text-lg shrink-0"></i>
            <span class="break-words min-w-0">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- TOP SEARCH & CATEGORY FILTER BAR (MATCHING REFERENCE PC & MOBILE HEADER SEARCH) -->
    <div class="bg-white rounded-2xl p-3 sm:p-4 shadow-xs border border-gray-100">
        <form method="get" asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index" id="filterForm">
            <div class="flex items-center gap-1.5 sm:gap-2 bg-gray-100/80 rounded-xl p-1 border border-gray-200/60">
                <!-- Search Input -->
                <div class="relative flex-1 min-w-0">
                    <input type="text" id="liveSearchInput" name="q" value="@currentSearch"
                           oninput="debounceLiveFilter()"
                           placeholder="Tìm kiếm sản phẩm..."
                           class="w-full pl-3 pr-7 py-2 text-base sm:text-sm bg-transparent text-gray-900 placeholder-gray-400 focus:outline-none" />
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <a href="@Url.Action("Index", "CuaHang", new { area = "CuaHang", danhMuc = currentCat != "Tất cả" ? currentCat : null, sort = currentSort })"
                           class="absolute inset-y-0 right-1.5 flex items-center text-xs text-gray-400 hover:text-gray-600" title="Xóa tìm kiếm">
                            <i class="fas fa-times-circle"></i>
                        </a>
                    }
                </div>

                <!-- Category Select inside Search Bar (PC & Tablet) -->
                <div class="hidden sm:flex items-center border-l border-gray-300/70 pl-2">
                    <select name="danhMuc" onchange="document.getElementById('filterForm').submit();"
                            aria-label="Chọn danh mục sản phẩm"
                            class="py-1.5 px-2 text-xs font-semibold bg-white rounded-lg border border-gray-200 text-gray-700 focus:outline-none">
                        <option value="Tất cả" selected="@(currentCat == "Tất cả")">Tất cả danh mục</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat" selected="@(string.Equals(currentCat, cat, StringComparison.OrdinalIgnoreCase))">@cat</option>
                        }
                    </select>
                </div>

                <!-- Red/Rose Search Button matching Image 2 -->
                <button type="submit" title="Tìm kiếm"
                        class="w-9 h-9 sm:w-10 sm:h-9 rounded-lg bg-[#e11d48] hover:bg-[#be123c] text-white flex items-center justify-center shrink-0 shadow-xs transition">
                    <i class="fas fa-search text-xs sm:text-sm"></i>
                </button>
            </div>

            <!-- Mobile Compact Category & Quick Filter Strip -->
            <div class="flex lg:hidden items-center gap-1.5 pt-2.5 overflow-x-auto pb-1 scrollbar-none">
                <a href="@Url.Action("Index", "CuaHang", new { area = "CuaHang", q = currentSearch, sort = currentSort, danhMuc = "Tất cả" })"
                   class="px-2.5 py-1 rounded-full text-[11px] font-bold transition shrink-0 @(currentCat == "Tất cả" ? "bg-[#e11d48] text-white shadow-xs" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    Tất cả (@totalCount)
                </a>
                @foreach (var cat in categories)
                {
                    bool isSelected = string.Equals(currentCat, cat, StringComparison.OrdinalIgnoreCase);
                    <a href="@Url.Action("Index", "CuaHang", new { area = "CuaHang", q = currentSearch, sort = currentSort, danhMuc = cat })"
                       class="px-2.5 py-1 rounded-full text-[11px] font-bold transition shrink-0 @(isSelected ? "bg-[#e11d48] text-white shadow-xs" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                        @cat
                    </a>
                }
            </div>

            <input type="hidden" name="sort" id="hiddenSortInput" value="@currentSort" />
        </form>
    </div>

    <!-- MAIN E-COMMERCE LAYOUT: LEFT SIDEBAR ON PC + PRODUCT GRID ON RIGHT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- LEFT SIDEBAR (PC VIEW - MATCHING IMAGE 2: DUYỆT DANH MỤC, BỘ LỌC GIÁ, SẢN PHẨM MỚI NHẤT) -->
        <aside class="hidden lg:block lg:col-span-3 xl:col-span-2 space-y-6 bg-white rounded-2xl p-4 border border-gray-100 shadow-xs">
            <!-- 1. Duyệt Danh mục -->
            <div>
                <h2 class="text-sm font-bold text-gray-900 pb-2 mb-3 border-b-2 border-gray-900 inline-block">
                    Duyệt Danh mục
                </h2>
                <ul class="space-y-2 text-xs">
                    <li>
                        <a href="@Url.Action("Index", "CuaHang", new { area = "CuaHang", q = currentSearch, sort = currentSort, danhMuc = "Tất cả" })"
                           class="flex items-center gap-1.5 py-1 transition @(currentCat == "Tất cả" ? "text-[#e11d48] font-bold" : "text-gray-600 hover:text-[#e11d48]")">
                            <i class="fas fa-angle-right text-[10px] opacity-70"></i>
                            <span class="truncate">Tất cả sản phẩm (@totalCount)</span>
                        </a>
                    </li>
                    @foreach (var cat in categories)
                    {
                        bool isSelected = string.Equals(currentCat, cat, StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a href="@Url.Action("Index", "CuaHang", new { area = "CuaHang", q = currentSearch, sort = currentSort, danhMuc = cat })"
                               class="flex items-center gap-1.5 py-1 transition @(isSelected ? "text-[#e11d48] font-bold" : "text-gray-600 hover:text-[#e11d48]")">
                                <i class="fas fa-angle-right text-[10px] opacity-70"></i>
                                <span class="truncate">@cat</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- 2. Bộ lọc Giá -->
            <div class="pt-2 border-t border-gray-100">
                <h2 class="text-sm font-bold text-gray-900 pb-2 mb-3 border-b-2 border-gray-900 inline-block">
                    Bộ lọc
                </h2>
                <div class="space-y-3">
                    <div class="text-xs font-semibold text-gray-700">Giá</div>
                    <div class="flex items-center gap-1.5">
                        <input type="number" id="minPriceInput" value="0" min="0" step="10000"
                               oninput="applyPriceInputFilter()"
                               aria-label="Giá tối thiểu"
                               class="w-full px-2 py-1.5 text-xs rounded-lg border border-gray-200 bg-gray-50 text-gray-800 text-center focus:outline-none" />
                        <span class="text-gray-400 text-xs">-</span>
                        <input type="number" id="maxPriceInput" value="1000000" min="0" step="10000"
                               oninput="applyPriceInputFilter()"
                               aria-label="Giá tối đa"
                               class="w-full px-2 py-1.5 text-xs rounded-lg border border-gray-200 bg-gray-50 text-gray-800 text-center focus:outline-none" />
                    </div>
                    <!-- Visual Range Bar matching Image 2 -->
                    <div class="relative h-1.5 bg-[#e11d48] rounded-full my-2">
                        <span class="absolute -left-1 -top-1 w-3.5 h-3.5 rounded-full bg-white border-2 border-[#e11d48] shadow-xs"></span>
                        <span class="absolute -right-1 -top-1 w-3.5 h-3.5 rounded-full bg-white border-2 border-[#e11d48] shadow-xs"></span>
                    </div>
                    <!-- Quick Filter Buttons -->
                    <div class="flex flex-wrap gap-1 pt-1">
                        <button type="button" onclick="filterByPriceRange('all', this)" class="price-filter-btn px-2 py-1 rounded-md text-[11px] font-bold bg-[#e11d48] text-white">
                            Tất cả
                        </button>
                        <button type="button" onclick="filterByPriceRange('under50', this)" class="price-filter-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200">
                            &lt; 50k
                        </button>
                        <button type="button" onclick="filterByPriceRange('50to150', this)" class="price-filter-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200">
                            50k-150k
                        </button>
                        <button type="button" onclick="filterByPriceRange('100charity', this)" class="price-filter-btn px-2 py-1 rounded-md text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                            100% Quỹ
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. Sản phẩm Mới nhất -->
            @if (newestProducts.Any())
            {
                <div class="pt-2 border-t border-gray-100">
                    <h2 class="text-sm font-bold text-gray-900 pb-2 mb-3 border-b-2 border-gray-900 inline-block">
                        Sản phẩm Mới nhất
                    </h2>
                    <div class="space-y-3">
                        @foreach (var np in newestProducts)
                        {
                            <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="ChiTiet" asp-route-id="@np.IDSanPham"
                               class="flex items-start gap-2.5 group">
                                <img src="@(string.IsNullOrEmpty(np.LinkHinhAnh) ? "/assets/default-product.jpg" : np.LinkHinhAnh)"
                                     alt="@np.TenSanPham"
                                     class="w-12 h-12 rounded-lg object-contain bg-gray-50 border border-gray-100 shrink-0 p-0.5" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-xs font-bold text-gray-800 group-hover:text-[#e11d48] line-clamp-2 leading-tight">
                                        @np.TenSanPham
                                    </div>
                                    <div class="flex items-center gap-0.5 text-[9px] text-gray-300 my-0.5">
                                        <i class="fas fa-star text-amber-400"></i>
                                        <i class="fas fa-star text-amber-400"></i>
                                        <i class="fas fa-star text-amber-400"></i>
                                        <i class="fas fa-star text-amber-400"></i>
                                        <i class="fas fa-star text-amber-400"></i>
                                        <span class="text-gray-400 ml-0.5">@np.DaBan Đánh giá</span>
                                    </div>
                                    <div class="text-xs font-bold text-[#e11d48]">
                                        @np.GiaBan.ToString("N0") ₫
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </aside>

        <!-- RIGHT MAIN PRODUCT CATALOG AREA -->
        <section class="lg:col-span-9 xl:col-span-10 space-y-3.5 min-w-0">

            <!-- Category Title & Toolbar Header (Matching Image 2) -->
            <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-gray-100">
                <h1 class="text-base sm:text-lg font-bold text-gray-800 truncate">
                    @(currentCat == "Tất cả" ? "Cửa Hàng Gây Quỹ Tình Nguyện" : currentCat)
                </h1>

                <div class="flex items-center gap-2 ml-auto">
                    <!-- Grid / List Decorator Icons -->
                    <div class="hidden sm:flex items-center gap-1">
                        <span class="w-7 h-7 rounded-md border border-[#e11d48]/40 text-[#e11d48] flex items-center justify-center text-xs bg-rose-50/50" title="Hiển thị dạng lưới">
                            <i class="fas fa-th-large"></i>
                        </span>
                    </div>

                    <!-- Sort Select -->
                    <select id="sortSelect" aria-label="Sắp xếp sản phẩm"
                            onchange="document.getElementById('hiddenSortInput').value = this.value; document.getElementById('filterForm').submit();"
                            class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-gray-200 bg-white text-gray-700 focus:outline-none">
                        <option value="" selected="@(string.IsNullOrEmpty(currentSort))">Mới Nhất</option>
                        <option value="moi-nhat" selected="@(currentSort == "moi-nhat")">Mới Nhất</option>
                        <option value="gia-tang" selected="@(currentSort == "gia-tang")">Giá tăng dần</option>
                        <option value="gia-giam" selected="@(currentSort == "gia-giam")">Giá giảm dần</option>
                        <option value="dong-gop" selected="@(currentSort == "dong-gop")">Đóng góp nhiều nhất</option>
                    </select>

                    <!-- Page Count Pill matching Image 2 -->
                    <span class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-gray-200 bg-white text-gray-700">
                        20 <i class="fas fa-chevron-down text-[9px] text-gray-400"></i>
                    </span>
                </div>
            </div>

            @if (productList.Any())
            {
                <!-- SYNCHRONIZED PRODUCT GRID:
                     - Mobile: 3 columns (grid-cols-3) matching Image 1
                     - Tablet: 3-4 columns (sm:grid-cols-3 md:grid-cols-4)
                     - PC: 5 columns (lg:grid-cols-4 xl:grid-cols-5) matching Image 2
                -->
                <div class="grid grid-cols-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-2 sm:gap-3.5">
                    @foreach (var item in productList)
                    {
                        <article class="group product-card min-w-0 bg-white rounded-xl sm:rounded-2xl border border-gray-200/80 hover:border-rose-200 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between p-2 sm:p-3 overflow-hidden relative"
                                 data-name="@item.TenSanPham.ToLower()" data-message="@(item.ThongDiepGayQuy?.ToLower() ?? "")"
                                 data-price="@((long)item.GiaBan)" data-charity="@item.PhanTramDongGop"
                                 data-instock="@(item.ConHang && item.SoLuongTon > 0 ? "true" : "false")">

                            <!-- Top Half: Square Product Image + Subtle Action / Stock Overlay -->
                            <div>
                                <div class="relative aspect-square rounded-lg sm:rounded-xl overflow-hidden bg-gray-50/70 mb-2 flex items-center justify-center">
                                    <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="ChiTiet" asp-route-id="@item.IDSanPham"
                                       class="w-full h-full flex items-center justify-center p-1 sm:p-2">
                                        <img src="@(string.IsNullOrEmpty(item.LinkHinhAnh) ? "/assets/default-product.jpg" : item.LinkHinhAnh)"
                                             alt="@item.TenSanPham"
                                             loading="lazy"
                                             class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
                                    </a>

                                    <!-- Out of stock / Stock status badge -->
                                    @if (item.ConHang && item.SoLuongTon > 0)
                                    {
                                        <span class="sr-only">Còn hàng (@item.SoLuongTon)</span>
                                    }
                                    else
                                    {
                                        <span class="absolute top-1 left-1 px-1.5 py-0.5 rounded-md text-[9px] sm:text-[10px] font-bold bg-gray-800/85 text-white">
                                            Hết hàng
                                        </span>
                                    }
                                </div>

                                <!-- Product Title (2-line clamp, bold dark text matching Image 1 & 2) -->
                                <h2 class="text-[11px] sm:text-[13px] font-bold text-gray-900 line-clamp-2 leading-snug min-h-[2.5em] group-hover:text-[#e11d48] transition break-all sm:break-words">
                                    <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="ChiTiet" asp-route-id="@item.IDSanPham">
                                        @item.TenSanPham
                                    </a>
                                </h2>

                                <!-- Star Rating & Review / Charity Count Row (Matching Image 1 & 2) -->
                                <div class="flex items-center gap-1 mt-1 text-[9px] sm:text-[11px] text-gray-400 truncate" title="@item.ThongDiepGayQuy">
                                    <span class="inline-flex items-center text-gray-300 shrink-0 tracking-tighter">
                                        <i class="fas fa-star text-[8px] sm:text-[10px]"></i>
                                        <i class="fas fa-star text-[8px] sm:text-[10px]"></i>
                                        <i class="fas fa-star text-[8px] sm:text-[10px]"></i>
                                        <i class="fas fa-star text-[8px] sm:text-[10px]"></i>
                                        <i class="fas fa-star text-[8px] sm:text-[10px]"></i>
                                    </span>
                                    <span class="truncate">@item.DaBan Đánh giá</span>
                                </div>

                                <!-- Hidden/Screen-reader Charity Metadata Preserving E2E Contract -->
                                <span class="sr-only">@item.ThongDiepGayQuy - đóng góp @item.PhanTramDongGop% gây quỹ</span>
                            </div>

                            <!-- Bottom Row: Price on Left + Square Pink/Red Cart Icon Button on Right (Matching Image 1 & 2) -->
                            <div class="pt-2 mt-1 flex items-center justify-between gap-1">
                                <div class="min-w-0 flex-1">
                                    <div class="text-[11px] sm:text-sm font-bold text-[#e11d48] truncate">
                                        @item.GiaBan.ToString("N0") <span class="underline text-[10px] sm:text-xs">đ</span>
                                    </div>
                                    @if (item.GiaGoc.HasValue && item.GiaGoc > item.GiaBan)
                                    {
                                        <div class="text-[9px] sm:text-[11px] text-gray-400 line-through truncate">
                                            @item.GiaGoc.Value.ToString("N0") đ
                                        </div>
                                    }
                                </div>

                                @if (item.ConHang && item.SoLuongTon > 0)
                                {
                                    <form asp-area="CuaHang" asp-controller="GioHang" asp-action="ThemVaoGio" method="post" class="shrink-0"
                                          onsubmit="return handleAddToCartAjax(event, @item.IDSanPham, 1, '@Html.Raw(Html.Encode(item.TenSanPham))', this);">
                                        <input type="hidden" name="id" value="@item.IDSanPham" />
                                        <input type="hidden" name="soLuong" value="1" />
                                        <button type="submit" title="Thêm vào giỏ"
                                                class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-rose-50 hover:bg-[#e11d48] text-[#e11d48] hover:text-white border border-rose-100 flex items-center justify-center transition active:scale-95">
                                            <i class="fas fa-shopping-cart text-[11px] sm:text-xs"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" disabled title="Sản phẩm tạm hết hàng"
                                            class="w-7 h-7 sm:w-8 sm:h-8 shrink-0 rounded-lg bg-gray-100 text-gray-400 border border-gray-200 cursor-not-allowed flex items-center justify-center">
                                        <i class="fas fa-shopping-cart text-[11px] sm:text-xs"></i>
                                    </button>
                                }
                            </div>

                        </article>
                    }
                </div>

                <!-- Result Count Summary Line (Matching "Hiển thị 1-5 của 5 kết quả" in Image 1 & 2) -->
                <div class="pt-2 text-center sm:text-left text-xs text-gray-500 font-medium" id="resultCountSummary">
                    Hiển thị 1-@productList.Count của @totalCount kết quả
                </div>
            }
            else
            {
                <!-- Empty Filter State -->
                <div class="text-center py-14 px-4 bg-white rounded-2xl border border-dashed border-gray-200 space-y-3">
                    <div class="w-14 h-14 rounded-full bg-rose-50 text-[#e11d48] mx-auto flex items-center justify-center text-xl">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-900">Không tìm thấy sản phẩm</h3>
                    <p class="text-xs sm:text-sm text-gray-500 max-w-md mx-auto">
                        Không có sản phẩm nào phù hợp với từ khóa "@currentSearch" hoặc danh mục đang chọn.
                    </p>
                    <div class="pt-1">
                        <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index"
                           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#e11d48] hover:bg-[#be123c] text-white font-bold text-xs shadow-xs transition">
                            <i class="fas fa-redo-alt text-[10px]"></i>
                            <span>Xem tất cả sản phẩm</span>
                        </a>
                    </div>
                </div>
            }
        </section>

    </div>

</div>

@section Scripts {
    <script>
        let liveFilterTimeout = null;
        let selectedPriceFilter = 'all';

        function debounceLiveFilter() {
            clearTimeout(liveFilterTimeout);
            liveFilterTimeout = setTimeout(() => {
                applyClientFilter();
            }, 200);
        }

        function filterByPriceRange(range, btn) {
            selectedPriceFilter = range;
            document.querySelectorAll('.price-filter-btn').forEach(b => {
                b.classList.remove('bg-[#e11d48]', 'text-white');
                b.classList.add('bg-gray-100', 'text-gray-700');
            });
            if (btn) {
                btn.classList.remove('bg-gray-100', 'text-gray-700');
                btn.classList.add('bg-[#e11d48]', 'text-white');
            }
            applyClientFilter();
        }

        function applyPriceInputFilter() {
            selectedPriceFilter = 'custom';
            applyClientFilter();
        }

        function applyClientFilter() {
            const query = (document.getElementById('liveSearchInput')?.value || '').toLowerCase().trim();
            const minInput = parseFloat(document.getElementById('minPriceInput')?.value || '0');
            const maxInput = parseFloat(document.getElementById('maxPriceInput')?.value || '999999999');
            const cards = document.querySelectorAll('.product-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const msg = card.getAttribute('data-message') || '';
                const price = parseFloat(card.getAttribute('data-price') || '0');
                const charity = parseFloat(card.getAttribute('data-charity') || '0');

                let matchSearch = !query || name.includes(query) || msg.includes(query);
                let matchPrice = true;

                if (selectedPriceFilter === 'under50') {
                    matchPrice = price < 50000;
                } else if (selectedPriceFilter === '50to150') {
                    matchPrice = price >= 50000 && price <= 150000;
                } else if (selectedPriceFilter === 'over150') {
                    matchPrice = price > 150000;
                } else if (selectedPriceFilter === '100charity') {
                    matchPrice = charity >= 100;
                } else if (selectedPriceFilter === 'custom') {
                    matchPrice = price >= minInput && price <= maxInput;
                }

                if (matchSearch && matchPrice) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const summary = document.getElementById('resultCountSummary');
            if (summary) {
                summary.textContent = visibleCount > 0
                    ? `Hiển thị 1-${visibleCount} của ${visibleCount} kết quả`
                    : 'Hiển thị 0 kết quả';
            }
        }

        async function handleAddToCartAjax(event, id, qty, name, form) {
            if (event) event.preventDefault();
            try {
                const formData = new URLSearchParams();
                formData.append('id', id);
                formData.append('soLuong', qty);

                const response = await fetch('/CuaHang/GioHang/ThemVaoGio', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData.toString()
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data && data.success) {
                        document.querySelectorAll('#cartCountBadge, #floatingCartCount').forEach(badge => {
                            badge.textContent = data.totalQuantity;
                        });

                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message || `Đã thêm "${name}" vào giỏ hàng!`,
                                showConfirmButton: false,
                                timer: 2500,
                                timerProgressBar: true
                            });
                        }
                        return false;
                    }
                }
                form.submit();
            } catch (err) {
                form.submit();
            }
            return false;
        }
    </script>
}
