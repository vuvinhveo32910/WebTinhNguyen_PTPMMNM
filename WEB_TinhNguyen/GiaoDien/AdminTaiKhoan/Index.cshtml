@model IEnumerable<WEB_TinhNguyen.MoHinh.TaiKhoanAdmin>
@using WEB_TinhNguyen.MoHinh
@{
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền Quản trị";
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
    var danhSachPhanHe = QuyenAdmin.DanhSachPhanHe.ToDictionary(p => p.MaPhanHe, p => p, StringComparer.OrdinalIgnoreCase);
}

<div class="max-w-7xl mx-auto my-6 px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-200 pb-5">
        <div>
            <nav class="flex items-center gap-2 text-xs text-gray-500 mb-2 font-medium">
                <a href="@Url.Action("Index", "Admin", new { area = "" })" class="hover:text-emerald-600 transition flex items-center gap-1">
                    <i class="fas fa-home"></i> Quản trị
                </a>
                <span>/</span>
                <span class="text-emerald-700 font-semibold">Tài khoản &amp; Phân quyền</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
                <span class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-lg shadow-sm">
                    <i class="fas fa-user-shield"></i>
                </span>
                <span>Quản lý Tài khoản &amp; Phân quyền Quản trị</span>
            </h1>
            <p class="mt-1 text-sm text-gray-500">
                Thêm mới, chỉnh sửa tài khoản quản trị và phân quyền truy cập chi tiết theo từng phân hệ chức năng (1–2 phân hệ tùy ý hoặc Toàn quyền hệ thống).
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="@Url.Action("Create", "AdminTaiKhoan", new { area = "" })"
               class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold rounded-xl text-white bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 shadow-md hover:shadow-lg transition">
                <i class="fas fa-user-plus"></i>
                <span>Thêm tài khoản quản trị</span>
            </a>
        </div>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center p-4 text-sm text-emerald-800 border border-emerald-200 rounded-2xl bg-emerald-50 shadow-sm transition">
            <i class="fas fa-check-circle text-emerald-600 text-lg mr-3"></i>
            <div><span class="font-bold">Thành công!</span> @TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center p-4 text-sm text-red-800 border border-red-200 rounded-2xl bg-red-50 shadow-sm transition">
            <i class="fas fa-exclamation-circle text-red-600 text-lg mr-3"></i>
            <div><span class="font-bold">Lỗi!</span> @TempData["Error"]</div>
        </div>
    }

    <!-- STATS OVERVIEW CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-users-cog"></i>
            </div>
            <div>
                <span class="text-xs text-gray-400 uppercase font-semibold">Tổng tài khoản</span>
                <p class="text-xl font-bold text-gray-800">@Model.Count()</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-crown"></i>
            </div>
            <div>
                <span class="text-xs text-gray-400 uppercase font-semibold">Toàn quyền (ALL)</span>
                <p class="text-xl font-bold text-gray-800">@Model.Count(a => a.LaToanQuyen)</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-sliders-h"></i>
            </div>
            <div>
                <span class="text-xs text-gray-400 uppercase font-semibold">Phân quyền tùy chọn</span>
                <p class="text-xl font-bold text-gray-800">@Model.Count(a => !a.LaToanQuyen)</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-user-check"></i>
            </div>
            <div>
                <span class="text-xs text-gray-400 uppercase font-semibold">Đang hoạt động</span>
                <p class="text-xl font-bold text-gray-800">@Model.Count(a => a.TrangThaiHoatDong)</p>
            </div>
        </div>
    </div>

    <!-- MAIN TABLE CARD -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="font-bold text-gray-800">Danh sách Tài khoản Quản trị &amp; Quyền hạn</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600">@Model.Count() tài khoản</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-xs uppercase text-gray-500 font-semibold">
                    <tr>
                        <th class="px-6 py-3.5 text-left">Tài khoản</th>
                        <th class="px-6 py-3.5 text-left">Họ và tên / Liên hệ</th>
                        <th class="px-6 py-3.5 text-left">Phân quyền chức năng được cấp</th>
                        <th class="px-6 py-3.5 text-center">Trạng thái</th>
                        <th class="px-6 py-3.5 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @foreach (var item in Model)
                    {
                        var isRootAdmin = string.Equals(item.TenDangNhap, "admin", StringComparison.OrdinalIgnoreCase);
                        var isCurrentAccount = string.Equals(item.TenDangNhap, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                        var dsQuyen = item.LayDanhSachQuyen();

                        <tr class="hover:bg-gray-50/70 transition">
                            <!-- TÀI KHOẢN -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl @(item.LaToanQuyen ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700") flex items-center justify-center font-bold text-sm shadow-sm">
                                        <i class="fas @(item.LaToanQuyen ? "fa-crown" : "fa-user-cog")"></i>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-gray-900">@item.TenDangNhap</span>
                                            @if (isRootAdmin)
                                            {
                                                <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-amber-100 text-amber-800 border border-amber-200">
                                                    Mặc định gốc
                                                </span>
                                            }
                                            @if (isCurrentAccount)
                                            {
                                                <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-emerald-100 text-emerald-800">
                                                    Bạn
                                                </span>
                                            }
                                        </div>
                                        <span class="text-xs text-gray-400">ID: #@item.IDTaiKhoan</span>
                                    </div>
                                </div>
                            </td>

                            <!-- HỌ TÊN / EMAIL -->
                            <td class="px-6 py-4">
                                <div class="font-semibold text-gray-800">@item.HoTen</div>
                                <div class="text-xs text-gray-500">
                                    @(string.IsNullOrWhiteSpace(item.Email) ? "Chưa cập nhật email" : item.Email)
                                </div>
                                @if (item.LanDangNhapCuoi.HasValue)
                                {
                                    <div class="text-[11px] text-gray-400 mt-0.5">
                                        Đăng nhập cuối: @item.LanDangNhapCuoi.Value.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                }
                            </td>

                            <!-- PHÂN QUYỀN -->
                            <td class="px-6 py-4">
                                @if (item.LaToanQuyen)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                        <i class="fas fa-shield-alt text-amber-600"></i>
                                        <span>Toàn quyền cấu hình hệ thống (ALL - 11/11 phân hệ)</span>
                                    </span>
                                }
                                else if (dsQuyen.Any())
                                {
                                    <div class="flex flex-wrap gap-1.5 max-w-md">
                                        @foreach (var maQuyen in dsQuyen)
                                        {
                                            if (danhSachPhanHe.TryGetValue(maQuyen, out var info))
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                    <i class="fas @info.Icon text-[11px] text-emerald-600"></i>
                                                    <span>@info.TenHienThi</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700">
                                                    @maQuyen
                                                </span>
                                            }
                                        }
                                    </div>
                                    <div class="text-[11px] text-gray-400 mt-1">
                                        Được cấp @dsQuyen.Count / @QuyenAdmin.DanhSachPhanHe.Count phân hệ
                                    </div>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-red-50 text-red-600">
                                        <i class="fas fa-ban"></i> Chưa cấp quyền
                                    </span>
                                }
                            </td>

                            <!-- TRẠNG THÁI -->
                            <td class="px-6 py-4 text-center whitespace-nowrap">
                                @if (item.TrangThaiHoatDong)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                        Đã khóa
                                    </span>
                                }
                            </td>

                            <!-- THAO TÁC -->
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-2">
                                    <a href="@Url.Action("Edit", "AdminTaiKhoan", new { id = item.IDTaiKhoan, area = "" })"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
                                       title="Phân quyền & Chỉnh sửa">
                                        <i class="fas fa-user-edit"></i>
                                        <span>Phân quyền / Sửa</span>
                                    </a>

                                    @if (!isRootAdmin)
                                    {
                                        <form asp-action="ToggleStatus" asp-controller="AdminTaiKhoan" asp-route-id="@item.IDTaiKhoan" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold @(item.TrangThaiHoatDong ? "bg-amber-50 text-amber-700 hover:bg-amber-100" : "bg-emerald-50 text-emerald-700 hover:bg-emerald-100") transition"
                                                    title="@(item.TrangThaiHoatDong ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <i class="fas @(item.TrangThaiHoatDong ? "fa-lock" : "fa-lock-open")"></i>
                                                <span>@(item.TrangThaiHoatDong ? "Khóa" : "Mở")</span>
                                            </button>
                                        </form>

                                        @if (!isCurrentAccount)
                                        {
                                            <form asp-action="Delete" asp-controller="AdminTaiKhoan" asp-route-id="@item.IDTaiKhoan" method="post" class="inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản @item.TenDangNhap không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold bg-red-50 text-red-600 hover:bg-red-100 transition"
                                                        title="Xóa tài khoản">
                                                    <i class="fas fa-trash-alt"></i>
                                                    <span>Xóa</span>
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

